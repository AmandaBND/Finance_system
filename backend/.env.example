PORT=3001
NODE_ENV=production

# Company
COMPANY_NAME=GroovyMark
COMPANY_EMAIL=finance@groovymark.com
CURRENCY=LKR
CURRENCY_SYMBOL=Rs.

# SMTP Email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=finance@groovymark.com
SMTP_PASS=your-smtp-password

# OpenAI
OPENAI_API_KEY=sk-proj-...

# URLs — set to your actual domain (no trailing slash)
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
